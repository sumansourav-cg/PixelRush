{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hakathon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hakathon/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
